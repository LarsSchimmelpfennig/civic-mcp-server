/**
 * Wrangler configuration
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",

  /* --------------------------------------------------
     Basic metadata
  -------------------------------------------------- */
  "name": "civic-mcp-server",
  "main": "src/index.ts",

  /* --------------------------------------------------
     Runtime compatibility
  -------------------------------------------------- */
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],

  // 1) Declare your KV namespace binding here:
  // "kv_namespaces": [
  //   {
  //     "binding": "RESOLVER_KV",   // the variable name in your Worker
  //     "id": "33f967e8ca794875ab58adfca1aa83e0" // the namespace ID from Cloudflare
  //   }
  // ],

  /* --------------------------------------------------
     Durable Objects
  -------------------------------------------------- */
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",   // must match what the SDK expects
        "class_name": "CivicMCP"  // the class you export in index.ts
      }
    ]
  },

  /* --------------------------------------------------
     Migrations – first tag that introduces CivicMCP
     (add another tag later if you change storage shape)
  -------------------------------------------------- */
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CivicMCP"] }
  ],

  /* --------------------------------------------------
     Environment variables (optional but recommended)
  -------------------------------------------------- */
  "vars": {
    "CIVIC_URL": "https://civicdb.org/api/graphql"
  },

  /* --------------------------------------------------
     Cloudflare observability (optional)
  -------------------------------------------------- */
  "observability": { "enabled": true },

 /* --------------------------------------------------
     v2 (NEW worker)
  -------------------------------------------------- */
  "env": {
    "v2": {
      "name": "civic-mcp-server-v2",
      "main": "src/index.v2.ts",

      "compatibility_date": "2025-03-10",
      "compatibility_flags": ["nodejs_compat"],

      "durable_objects": {
        "bindings": [
          {
            "name": "MCP_OBJECT",
            "class_name": "CivicMCP"
          }
        ]
      },

      // Separate initial migration for v2
      "migrations": [
        { "tag": "v2", "new_sqlite_classes": ["CivicMCP"] }
      ],

      "vars": {
        "CIVIC_URL": "https://civicdb.org/api/graphql"
      },

      "observability": { "enabled": true }
    }
  }
}


// DEPLOY COMMANDS
// npx wrangler deploy          # redeploys v1 (no URL change)
// npx wrangler deploy --env v2 # deploys v2 as a second worker